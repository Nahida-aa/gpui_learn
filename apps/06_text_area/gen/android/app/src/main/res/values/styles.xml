<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- gpui-android 例子共用的全屏无标题主题。由 gpui-cli 生成到每个例子的 res。 -->
    <style name="GpuiTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">#1e1e2e</item>
        <item name="android:statusBarColor">#1e1e2e</item>
    </style>
</resources>
