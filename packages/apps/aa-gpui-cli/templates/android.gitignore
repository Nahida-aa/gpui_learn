# 本文件由 `gpui-cli android init` 生成，作用于 gen/android/。
# 仅忽略「构建产物」与「从例子 assets/ 拷贝来的资源」；生成的 Gradle 源码
# （build.gradle.kts / AndroidManifest.xml / settings.gradle.kts / gradlew /
# wrapper / res 等）与 Tauri 一样纳入版本追踪，便于 review 与复现。

# Gradle 构建产物
.gradle/
build/
app/build/
app/.cxx/
.externalNativeBuild/

# IDE
*.iml
.idea/

# Gradle 本地配置（含 SDK 路径，机器相关）
local.properties

# cargo ndk 编出的原生库（重新生成即可）
app/src/main/jniLibs/

# 从例子 assets/ 拷贝来的资源（如 emoji 字体，原始在例子 assets/ 里）
app/src/main/assets/
